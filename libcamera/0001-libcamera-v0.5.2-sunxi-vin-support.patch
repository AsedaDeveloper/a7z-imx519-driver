+void DebayerCpu::setupInputMemcpyMt(LineBufState &lb, const uint8_t *linePointers[])
+{
+	const unsigned int patternHeight = inputConfig_.patternSize.height;
+
+	if (!enableInputMemcpy_)
+		return;
