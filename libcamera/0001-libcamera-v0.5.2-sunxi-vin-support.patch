+	/* at least 32 rows per band: no point splitting tiny or odd-shaped windows further */
+	unsigned int maxBands = std::max(1u, window_.height / 32);
+	nThreads = std::min(nThreads, maxBands);
+	if (nThreads <= 1)
+		return false;
