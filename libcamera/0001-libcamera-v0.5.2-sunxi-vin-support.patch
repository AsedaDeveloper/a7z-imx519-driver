+	unsigned int rowsPerBand = ((window_.height / nThreads) + 1) & ~1u; /* round up to even */
+	std::vector<LineBufState> lineBufs(nThreads);
+	std::mutex statsMutex;
+	std::vector<std::thread> workers;
+	workers.reserve(nThreads - 1);
