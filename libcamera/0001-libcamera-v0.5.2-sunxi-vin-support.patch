+	unsigned int y = 0;
+	for (unsigned int i = 0; i < nThreads && y < window_.height; i++) {
+		unsigned int yStart = y;
+		unsigned int yEnd = std::min(y + rowsPerBand, window_.height);
+		bool isFirst = (i == 0);
+		bool isLast = (yEnd >= window_.height);
