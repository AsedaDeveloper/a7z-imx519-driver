+			process2Band(yStart, yEnd, isFirst, true, src, dst, lineBufs[i], statsMutex);
+			y = window_.height;
+			break;
+		}
+		y = yEnd;
+	}
+	for (std::thread &t : workers)
+		t.join();
+
+	return true;
