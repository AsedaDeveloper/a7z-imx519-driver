/dts-v1/;

/ {

	metadata {
		title = "IMX519 on J5 (A7A-style csi1/mipi1, TWI3, PE8/PE9, MCLK1)";
		compatible = "radxa,cubie-a7a", "radxa,cubie-a7z", "radxa,cubie-a7s";
		category = "camera";
		exclusive = "vind0", "csi0", "PE8", "PE9", "PE3", "PE4";
		description = "IMX519 on J5 with the Allwinner hardware ISP path (experimental).";
	};

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			csi_top = <0x29f63000>;
			csi_isp = <0x29f63000>;
			vind_mclkpin-supply = <0xffffffff>;
			vind_mclkpin_vol = <0x1b7740>;
			vind_mcsipin-supply = <0xffffffff>;
			vind_mcsipin_vol = <0x1b7740>;
			vind_mipipin-supply = <0xffffffff>;
			vind_mipipin_vol = <0x1b7740>;
			status = "okay";
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			pinctrl-0;
			pinctrl-1;
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			pinctrl-0;
			pinctrl-1;
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			work_mode = <0x01>;
			status = "okay";
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			work_mode = <0x01>;
			status = "okay";
		};
	};

	fragment@5 {
